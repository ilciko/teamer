#!/usr/bin/env bash
# Teamer — amministrazione da shell, per l'IT (root).
#
#   teamer-admin init [--admin NOME]   crea la chiave di sistema del DB (se manca) e il primo site admin
#   teamer-admin create-admin NOME     nuovo site admin (password provvisoria)
#   teamer-admin create-user NOME --role admin|director|hr
#   teamer-admin reset-password NOME   password provvisoria, da cambiare al primo accesso
#   teamer-admin unlock NOME           toglie il blocco per troppi tentativi
#   teamer-admin enable|disable NOME
#   teamer-admin list-users
#   teamer-admin assign-unassigned NOME  assegna al director NOME i dati senza proprietario
#   teamer-admin list-teams              albero dei team con il titolare
#   teamer-admin restore FILE [--source-key | --password]
#                                      sostituisce i dati con quelli del file (backup, altra istanza,
#                                      DB della 0.29); utenti e audit restano. Ferma e riavvia il servizio.
#
# La chiave (predefinita /etc/teamer/db.key, root:teamer 0640) cifra il database: la
# conosce solo l'IT. PERDERLA = PERDERE I DATI: conservarne una copia fuori dal server.
# teamer-update non la tocca mai. I comandi sul DB girano come utente `teamer`, così
# journal e wal restano suoi.
set -euo pipefail

APP_DIR="/opt/teamer"
[[ $EUID -eq 0 ]] || { echo "teamer-admin va eseguito come root" >&2; exit 1; }
[[ -f "$APP_DIR/.env" ]] || { echo "manca $APP_DIR/.env: Teamer non è installato qui" >&2; exit 1; }
set -a; source "$APP_DIR/.env"; set +a
KEY_FILE="${TEAMER_DB_KEY_FILE:-/etc/teamer/db.key}"
export TEAMER_DB_KEY_FILE="$KEY_FILE"

if [[ "${1:-}" == "init" && ! -f "$KEY_FILE" ]]; then
  install -d -m 750 -o root -g teamer "$(dirname "$KEY_FILE")"
  ( umask 027; head -c 32 /dev/urandom | od -An -tx1 | tr -d ' \n' > "$KEY_FILE"; echo >> "$KEY_FILE" )
  chown root:teamer "$KEY_FILE"
  chmod 640 "$KEY_FILE"
  echo "Chiave di sistema creata in $KEY_FILE."
  echo "CONSERVANE UNA COPIA FUORI DAL SERVER: senza chiave il database non si apre più."
fi

cd "$APP_DIR/src"
if [[ "${1:-}" == "restore" ]]; then
  # il file deve essere leggibile da teamer, e lo scambio non deve avvenire sotto il servizio
  [[ -f "${2:-}" ]] || { echo "uso: teamer-admin restore FILE [--source-key | --password]" >&2; exit 1; }
  IMPORT="$APP_DIR/data/restore/import-cli.db"
  install -d -m 750 -o teamer -g teamer "$APP_DIR/data/restore"
  install -m 600 -o teamer -g teamer "$2" "$IMPORT"
  shift 2
  WAS_ACTIVE=0
  if systemctl is-active --quiet teamer; then WAS_ACTIVE=1; systemctl stop teamer; fi
  trap 'rm -f "$IMPORT"; (( WAS_ACTIVE )) && systemctl start teamer' EXIT
  runuser -u teamer -- "$APP_DIR/src/.venv/bin/python" -m app.admin_cli restore "$IMPORT" "$@"
  exit $?
fi
exec runuser -u teamer -- "$APP_DIR/src/.venv/bin/python" -m app.admin_cli "$@"
