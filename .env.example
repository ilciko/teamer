# Teamer — configurazione (copiare in .env)
# Percorso del database cifrato (la directory viene creata se manca)
TEAMER_DB_PATH=data/teamer.db
# Chiave di sistema del DB (solo IT). In produzione /etc/teamer/db.key, creata da
# `teamer-admin init`; in sviluppo `make key` la genera in data/dev.key.
# Perdere la chiave = perdere i dati: conservarne una copia a parte.
TEAMER_DB_KEY_FILE=data/dev.key
# Bind del server (in produzione dietro reverse proxy: 0.0.0.0)
TEAMER_HOST=127.0.0.1
TEAMER_PORT=8000
# Chiave per firmare i cookie di sessione (generare con: openssl rand -hex 32)
TEAMER_SECRET=cambiami
# Sessione: nessun timeout di inattività. La sessione di un utente si blocca quando
# la sua ultima pagina Teamer viene chiusa (o smette di rispondere per
# TEAMER_LOCK_GRACE_SECONDS); il DB resta aperto per gli altri utenti.
TEAMER_HEARTBEAT_SECONDS=20
TEAMER_LOCK_GRACE_SECONDS=90
# TEAMER_IDLE_MINUTES non è più usato: se presente viene ignorato.
